@@ -112,6 +116,20 @@ pub fn decommit(
         }
     }
 
+    // FreeBSD FREE permits lazy reclamation without releasing the address
+    // range. It does not guarantee zeroes on subsequent reads, so zero mode
+    // must clear its dirty prefix first. Strict callers overwrite the entire
+    // mapping when decompressing; writing it cancels pending reclamation.
+    if (comptime builtin.os.tag == .freebsd) {
+        if (comptime mode == .zero) @memset(memory[0..dirty_len], 0);
+        if (std.posix.madvise(memory.ptr, memory.len, std.posix.MADV.FREE)) |_|
+            return true
+        else |err| {
+            log.warn("madvise(FREE) failed err={}", .{err});
+            return false;
+        }
+    }
+
